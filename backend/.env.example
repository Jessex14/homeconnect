DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://app:app@localhost:5432/property_platform
CSRF_TRUSTED_ORIGINS=http://localhost:8000
TENANT_INVITATION_FRONTEND_URL=http://127.0.0.1:8000/tenant-invitation
TENANT_INVITATION_TTL_HOURS=72
MPESA_CALLBACK_BASE_URL=https://your-public-https-domain.example
MPESA_CREDENTIALS_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
MPESA_ALLOW_PRODUCTION=false
MPESA_HTTP_TIMEOUT=20
# Optional rent Q&A provider. Uncomment and set in the server environment to enable;
# OpenAI API usage is billed separately based on tokens.
# RENT_QA_PROVIDER=apps.assistant.openai_provider.OpenAIRentAnswerProvider
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna
# OPENAI_TIMEOUT_SECONDS=20
